// Schema consolidado a partir de las 72 migraciones legacy en supabase/*.sql
// (incluye los fixes posteriores: 037, 062, 063, 068, 069, 070, 071, 072 —
// el estado modelado acá es el FINAL correcto, no cada paso intermedio).
//
// Reglas de negocio preservadas a propósito (ver docs/especificacion_funcional_legacy.md
// y el plan en C:\Users\alane\.claude\plans\necesito-que-entiendas-el-compiled-kernighan.md):
//   - El stock NUNCA es una columna persistida: se deriva agregando MovimientoInventario.
//   - Venta.estadoCobro / esSenia / montoSenia / saldoPendiente se preservan literal.
//   - El rol normalizado (dueno/operador/contador) vive en
//     apps/api/src/common/auth/rol.types.ts — acá se guarda el rol CRUDO
//     (RolCrudo) tal cual lo definió Fase 2 en usuarios.repository.ts, para
//     no perder fidelidad con los datos legacy migrados en Fase 7.
//   - `planes`, `suscripciones` y `aceptaciones_terminos` no tienen CREATE TABLE
//     en las migraciones (se crearon a mano en Supabase Studio) — su forma se
//     infirió de cómo las usan las funciones SQL y src/lib/planes.ts.
//   - notificaciones, segmentos de clientes e insights de combos NO son tablas
//     persistidas en el legacy (contar_notificaciones(), segmentos_clientes(),
//     insights_combos() son funciones que calculan todo al vuelo) — por eso no
//     tienen modelo acá; la Fase 4 los replica como queries de servicio, no
//     como entidades.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==== Empresas / Planes / Suscripciones ====

model Empresa {
  id                 String    @id @default(uuid()) @db.Uuid
  clerkOrgId         String?   @unique @map("clerk_org_id")
  nombre             String
  rubro              String?
  planActual         String    @default("starter") @map("plan_actual") // legacy display field; la fuente de verdad real es Suscripcion
  activo             Boolean   @default(true)
  esDemo             Boolean   @default(false) @map("es_demo")
  umbralConfirmacion Decimal?  @map("umbral_confirmacion") @db.Decimal(12, 2)
  /// WhatsApp de contacto que dejó al registrarse.
  telefono           String?
  /// Cómo nos conoció (registro propio).
  origenRegistro     String?   @map("origen_registro")
  /// CUIT (opcional, sin guiones): también controla que el mes gratis de un cupón sea de un solo uso.
  cuit               String?
  /// Cámara de la que vino (por su código) y el cupón que usó.
  camaraId           String?   @map("camara_id") @db.Uuid
  cuponId            String?   @map("cupon_id") @db.Uuid
  /// Prueba gratis que recibió (14 días o la del cupón).
  pruebaDesde        DateTime? @map("prueba_desde") @db.Date
  pruebaHasta        DateTime? @map("prueba_hasta") @db.Date
  /// Inicio del primer período pago: arranca la ventana de comisión.
  primerPagoEn       DateTime? @map("primer_pago_en") @db.Date
  /// Número de orden dentro de la cámara (con el primer pago; no cambia aunque otros se den de baja).
  ordenCamara        Int?      @map("orden_camara")
  comisionPct        Decimal?  @map("comision_pct") @db.Decimal(5, 2)
  /// Fin (excluido) de la comisión de la cámara por este cliente.
  comisionHasta      DateTime? @map("comision_hasta") @db.Date
  /// Precio especial acordado (ej. clientes piloto): en ese plan se cobra este precio mensual en vez del de lista.
  precioEspecialPlan    String?  @map("precio_especial_plan") @db.VarChar(20)
  precioEspecialMensual Decimal? @map("precio_especial_mensual") @db.Decimal(12, 2)
  precioEspecialNota    String?  @map("precio_especial_nota") @db.VarChar(200)
  createdAt          DateTime  @default(now()) @map("created_at")
  deletedAt          DateTime? @map("deleted_at")

  camara                    Camara?                @relation(fields: [camaraId], references: [id])
  cupon                     Cupon?                 @relation("EmpresaCupon", fields: [cuponId], references: [id])
  cuponesReferido           Cupon[]                @relation("CuponReferente")
  cambiosOrigen             CambioOrigen[]
  comisiones                Comision[]
  cuotasProgramadas         CuotaProgramada[]

  informesConfig            InformesConfig?
  premiosGanados            PremioReferido[]       @relation("PremioReferente")
  premioComoReferida        PremioReferido?        @relation("PremioReferida")
  informesEnviados          InformeEnviado[]

  usuarios                  Usuario[]
  historialPlanes           HistorialPlan[]
  suscripciones             Suscripcion[]
  aceptacionesTerminos      AceptacionTerminos[]
  configuracion             ConfiguracionEmpresa?
  productos                 Producto[]
  categorias                Categoria[]
  atributos                 Atributo[]
  preciosHistorial          PrecioHistorial[]
  movimientosInventario     MovimientoInventario[]
  ubicaciones               Ubicacion[]
  lotes                     Lote[]
  ventas                    Venta[]
  ventasItems               VentaItem[]
  ventasNumeracion          VentaNumeracion?
  anulaciones               Anulacion[]
  devoluciones              Devolucion[]
  compras                   Compra[]
  comprasItems              CompraItem[]
  proveedores               Proveedor[]
  ordenesCompra             OrdenCompra[]
  ordenesCompraNumeracion   OrdenCompraNumeracion?
  clientes                  Cliente[]
  clientesInteracciones     ClienteInteraccion[]
  difusiones                Difusion[]
  pedidos                   Pedido[]
  pedidosNumeracion         PedidoNumeracion?
  invitacionesColaboradores InvitacionColaborador[]
  colaboradorPermisos       ColaboradorPermiso[]
  gastos                    Gasto[]
  movimientosFinancieros    MovimientoFinanciero[]
  tickets                   Ticket[]
  pagos                     Pago[]
  listasPrecios             ListaPrecio[]
  avisosAdmin               AvisoAdmin[]
  recetas                   Receta[]
  ordenesProduccion         OrdenProduccion[]
  cobrosClientes            CobroCliente[]
  tienda                    TiendaConfig?
  imagenesProductos         ProductoImagen[]

  eventosUso EventoUso[]
  cuponesTienda CuponTienda[]
  cuentasTienda CuentaTienda[]
  @@unique([camaraId, ordenCamara])
  @@map("empresas")
}

model HistorialPlan {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String   @map("empresa_id") @db.Uuid
  planAnterior String?  @map("plan_anterior")
  planNuevo    String   @map("plan_nuevo")
  fechaCambio  DateTime @default(now()) @map("fecha_cambio")
  motivo       String?

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("historial_planes")
}

// No tiene CREATE TABLE en las migraciones (creada a mano en Supabase Studio).
// Forma inferida de admin_listar_planes()/admin_asignar_suscripcion() y de
// src/lib/planes.ts (PLANES const: límites/módulos por plan viven en código,
// no en esta tabla — acá solo lo que las funciones SQL leen/escriben).
model Plan {
  id        String   @id @default(uuid()) @db.Uuid
  nombre    String
  precioArs Decimal? @map("precio_ars") @db.Decimal(12, 2)
  activo    Boolean  @default(true)
  /// Cuotas sin interés para quien no tiene código (un cupón puede definir las suyas).
  cuotasTrimestral Int @default(3) @map("cuotas_trimestral")
  cuotasAnual      Int @default(3) @map("cuotas_anual")
  createdAt DateTime @default(now()) @map("created_at")

  suscripciones Suscripcion[]

  @@map("planes")
}

// Tampoco tiene CREATE TABLE explícito — forma inferida de registrar_empresa(),
// mi_suscripcion_activa() y admin_asignar_suscripcion().
model Suscripcion {
  id               String    @id @default(uuid()) @db.Uuid
  empresaId        String    @map("empresa_id") @db.Uuid
  planId           String?   @map("plan_id") @db.Uuid
  estado           String    @default("periodo_prueba") // periodo_prueba | activa | vencida | cancelada | pendiente_pago
  fechaInicio      DateTime  @default(now()) @map("fecha_inicio") @db.Date
  fechaVencimiento DateTime? @map("fecha_vencimiento") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at")

  empresa Empresa @relation(fields: [empresaId], references: [id])
  plan    Plan?   @relation(fields: [planId], references: [id])

  @@index([empresaId])
  @@map("suscripciones")
}

// Idem: sin CREATE TABLE propio — forma inferida de registrar_empresa().
model AceptacionTerminos {
  id        String   @id @default(uuid()) @db.Uuid
  empresaId String   @map("empresa_id") @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  version   String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("aceptaciones_terminos")
}

model AdminEmail {
  email String @id

  @@map("admin_emails")
}

// ==== Usuarios / Roles / Permisos ====

// Rol crudo tal cual vive hoy en la columna `usuarios.rol` del legacy —
// idéntico a RolCrudo en apps/api/src/common/auth/rol.types.ts. La
// normalización (dueno/operador/contador) es responsabilidad de la capa de
// aplicación (normalizarRol()), no del schema.
enum RolCrudo {
  dueno
  administrador
  operario
  operador
  contador
  visor
}

model Usuario {
  id                  String    @id @default(uuid()) @db.Uuid
  clerkUserId         String?   @unique @map("clerk_user_id")
  empresaId           String    @map("empresa_id") @db.Uuid
  nombre              String
  email               String
  rolCrudo            RolCrudo  @default(operador) @map("rol")
  activo              Boolean   @default(true)
  permisos            Json      @default("{}") // legado: { registrar_ventas, ver_historial, editar_productos, ver_costos, ajustar_stock, ver_reportes, anular_ventas }
  invitadoPorId       String?   @map("invitado_por") @db.Uuid
  invitacionPendiente Boolean   @default(false) @map("invitacion_pendiente")
  createdAt           DateTime  @default(now()) @map("created_at")
  deletedAt           DateTime? @map("deleted_at")

  empresa                Empresa                @relation(fields: [empresaId], references: [id])
  invitadoPor            Usuario?               @relation("UsuarioInvitadoPor", fields: [invitadoPorId], references: [id])
  invitados              Usuario[]              @relation("UsuarioInvitadoPor")
  movimientos            MovimientoInventario[]
  ventas                 Venta[]
  anulaciones            Anulacion[]
  devoluciones           Devolucion[]
  compras                Compra[]
  difusiones             Difusion[]
  pedidosAsignados       Pedido[]               @relation("PedidoAsignadoA")
  colaboradorPermiso     ColaboradorPermiso?
  gastos                 Gasto[]
  movimientosFinancieros MovimientoFinanciero[]
  tickets                Ticket[]
  ticketsRespuestas      TicketRespuesta[]
  asignacionFijaDe       ConfiguracionEmpresa[] @relation("AsignacionFijaUsuario")
  eventosUso             EventoUso[]

  @@index([empresaId])
  @@map("usuarios")
}

model ConfiguracionEmpresa {
  id                      String   @id @default(uuid()) @db.Uuid
  empresaId               String   @unique @map("empresa_id") @db.Uuid
  mediosPago              Json     @default("[\"efectivo\",\"transferencia\",\"debito\",\"credito\",\"mp_qr\"]") @map("medios_pago")
  tasasCuotas             Json     @map("tasas_cuotas")
  flujoVentas             Json     @default("{\"mostrar_cliente\":\"opcional\",\"crear_desde_venta\":true}") @map("flujo_ventas")
  inventario              Json     @default("{\"umbral_stock_bajo\":5}")
  ubicacionVentaDefault   String?  @map("ubicacion_venta_default")
  modoAsignacion          String   @default("manual") @map("modo_asignacion") // manual | round_robin | todo_a_uno
  asignacionFijaUsuarioId String?  @map("asignacion_fija_usuario_id") @db.Uuid
  asignacionRotacionIds   String[] @default([]) @map("asignacion_rotacion_ids") @db.Uuid
  pais                    String   @default("argentina") // argentina | peru | colombia | otro
  moneda                  String   @default("ARS")
  simboloMoneda           String   @default("$") @map("simbolo_moneda")
  alicuotaIva             Decimal  @default(21.00) @map("alicuota_iva") @db.Decimal(5, 2)
  nombreIva               String   @default("IVA") @map("nombre_iva")
  mostrarIvaVentas        Boolean  @default(false) @map("mostrar_iva_ventas")
  /// Dólar para ver los reportes en US$: blue | oficial | bolsa (MEP).
  dolarTipo               String   @default("blue") @map("dolar_tipo") @db.VarChar(10)
  /// monotributo | responsable_inscripto | exento | otro
  condicionFiscal         String   @default("monotributo") @map("condicion_fiscal")
  /// Letra de la categoría de monotributo (A a K), si corresponde.
  categoriaMonotributo    String?  @map("categoria_monotributo")
  usaVariantes            Boolean  @default(false) @map("usa_variantes")
  /// Costo de una hora de trabajo (para el costo de fabricar; no suma al valor del stock).
  valorHora               Decimal? @map("valor_hora") @db.Decimal(12, 2)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at")

  empresa               Empresa  @relation(fields: [empresaId], references: [id])
  asignacionFijaUsuario Usuario? @relation("AsignacionFijaUsuario", fields: [asignacionFijaUsuarioId], references: [id])

  @@map("configuracion_empresa")
}

// ==== Productos / Variantes / Categorías ====

model Producto {
  id           String    @id @default(uuid()) @db.Uuid
  empresaId    String    @map("empresa_id") @db.Uuid
  nombre       String
  categoria    String? // legado: texto libre, ver también CategoriaId
  categoriaId  String?   @map("categoria_id") @db.Uuid
  codigoBarra  String?   @map("codigo_barra")
  /// Código interno único por empresa (entre productos y variantes). Lo genera el sistema si queda vacío.
  sku          String?
  precioVenta  Decimal?  @map("precio_venta") @db.Decimal(12, 2) // valor "actual" cacheado; el histórico real vive en PrecioHistorial
  costo        Decimal?  @db.Decimal(12, 2)
  usaVariantes Boolean   @default(false) @map("usa_variantes")
  /// Insumo / materia prima: se compra y se usa para fabricar, no se vende tal cual.
  esInsumo     Boolean   @default(false) @map("es_insumo")
  /// unidad | kg | g | l | ml | m | cm
  unidad       String    @default("unidad")
  /// Se muestra en la tienda online (los insumos nunca se muestran).
  enTienda     Boolean   @default(true) @map("en_tienda")
  altoCm       Decimal?  @map("alto_cm") @db.Decimal(8, 2)
  largoCm      Decimal?  @map("largo_cm") @db.Decimal(8, 2)
  anchoCm      Decimal?  @map("ancho_cm") @db.Decimal(8, 2)
  pesoGr       Decimal?  @map("peso_gr") @db.Decimal(10, 2)
  activo       Boolean   @default(true)
  /// Oferta en la tienda online: porcentaje (20 = 20% off) o precio fijo; fechas opcionales (días de Argentina, inclusive).
  ofertaTipo   String?   @map("oferta_tipo") @db.VarChar(10)
  ofertaValor  Decimal?  @map("oferta_valor") @db.Decimal(12, 2)
  ofertaDesde  DateTime? @map("oferta_desde") @db.Date
  ofertaHasta  DateTime? @map("oferta_hasta") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  empresa            Empresa                @relation(fields: [empresaId], references: [id])
  categoriaRel       Categoria?             @relation(fields: [categoriaId], references: [id])
  preciosHistorial   PrecioHistorial[]
  movimientos        MovimientoInventario[]
  variantes          ProductoVariante[]
  lotes              Lote[]
  ventasItems        VentaItem[]
  comprasItems       CompraItem[]
  pedidosItems       PedidoItem[]
  ordenesCompraItems OrdenCompraItem[]
  devolucionesItems  DevolucionItem[]
  recetas            Receta[]               @relation("RecetaProducto")
  usadoEnRecetas     RecetaItem[]           @relation("RecetaInsumo")
  ordenesProduccion  OrdenProduccion[]
  imagenes           ProductoImagen[]

  @@index([empresaId])
  @@index([categoriaId]) // productos de una categoría
  @@map("productos")
}

model Categoria {
  id          String   @id @default(uuid()) @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  productos Producto[]

  @@unique([empresaId, nombre])
  @@map("categorias")
}

// Precio/costo vigentes a una fecha (histórico) — Producto.precioVenta/costo
// son un cache del último registro acá, igual que en el legacy.
model PrecioHistorial {
  id          String   @id @default(uuid()) @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  productoId  String   @map("producto_id") @db.Uuid
  variante    String?
  precioVenta Decimal  @map("precio_venta") @db.Decimal(12, 2)
  costo       Decimal  @db.Decimal(12, 2)
  fechaDesde  DateTime @default(now()) @map("fecha_desde") @db.Date
  monedaCosto String?  @default("ARS") @map("moneda_costo")
  tipoCambio  Decimal? @map("tipo_cambio") @db.Decimal(10, 2)

  empresa  Empresa  @relation(fields: [empresaId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@index([empresaId, productoId, fechaDesde])
  @@index([productoId]) // historial de precios de un producto
  @@map("precios_historial")
}

// Atributos globales configurables (Color, Talle, etc.) — "activo_ventas"
// permite ocultar un atributo de las ventas sin borrarlo.
model Atributo {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String   @map("empresa_id") @db.Uuid
  nombre       String
  valores      String[]
  activoVentas Boolean  @default(true) @map("activo_ventas")
  createdAt    DateTime @default(now()) @map("created_at")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("atributos")
}

// costo/precio de Producto = promedio ponderado de las variantes activas
// (regla de negocio de servicio, ver Fase 4 VariantesModule) — el schema solo
// necesita poder filtrar por `activo`.
model ProductoVariante {
  id          String    @id @default(uuid()) @db.Uuid
  productoId  String    @map("producto_id") @db.Uuid
  empresaId   String    @map("empresa_id") @db.Uuid
  sku         String?
  atributos   Json      @default("{}") // combinación libre { "Color": "Rojo", "Talle": "M" }
  precioVenta Decimal?  @map("precio_venta") @db.Decimal(12, 2)
  costo       Decimal?  @db.Decimal(12, 2)
  activo      Boolean   @default(true)
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  producto           Producto               @relation(fields: [productoId], references: [id])
  movimientos        MovimientoInventario[]
  lotes              Lote[]
  ventasItems        VentaItem[]
  comprasItems       CompraItem[]
  pedidosItems       PedidoItem[]
  ordenesCompraItems OrdenCompraItem[]
  devolucionesItems  DevolucionItem[]

  @@index([productoId]) // variantes de un producto
  @@map("producto_variantes")
}

// ==== Inventario (Ubicación, Lote, MovimientoInventario) ====

model Ubicacion {
  id          String   @id @default(uuid()) @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  nombre      String
  descripcion String?
  tipo        String   @default("otro")
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, nombre])
  @@map("ubicaciones")
}

model Lote {
  id               String    @id @default(uuid()) @db.Uuid
  empresaId        String    @map("empresa_id") @db.Uuid
  productoId       String    @map("producto_id") @db.Uuid
  varianteId       String?   @map("variante_id") @db.Uuid
  numeroLote       String    @map("numero_lote")
  fechaVencimiento DateTime? @map("fecha_vencimiento") @db.Date
  fechaElaboracion DateTime? @map("fecha_elaboracion") @db.Date
  cantidadInicial  Decimal   @default(0) @map("cantidad_inicial") @db.Decimal(12, 2)
  proveedorId      String?   @map("proveedor_id") @db.Uuid
  notas            String?
  activo           Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at")

  empresa      Empresa                @relation(fields: [empresaId], references: [id])
  producto     Producto               @relation(fields: [productoId], references: [id])
  variante     ProductoVariante?      @relation(fields: [varianteId], references: [id])
  proveedor    Proveedor?             @relation(fields: [proveedorId], references: [id])
  movimientos  MovimientoInventario[]
  pedidosItems PedidoItem[]

  @@map("lotes")
}

// El STOCK ACTUAL nunca se persiste: es SUM(cantidad * signo) agregado en
// tiempo de consulta sobre esta tabla, igual que en el legacy
// (listar_productos_empresa(), dashboard_inicio()).
model MovimientoInventario {
  id               String    @id @default(uuid()) @db.Uuid
  empresaId        String    @map("empresa_id") @db.Uuid
  productoId       String    @map("producto_id") @db.Uuid
  varianteId       String?   @map("variante_id") @db.Uuid
  loteId           String?   @map("lote_id") @db.Uuid
  usuarioId        String    @map("usuario_id") @db.Uuid
  tipo             String // venta | compra | ajuste_positivo | ajuste_negativo | transferencia | devolucion... (sin CHECK en el legacy, no forzar enum)
  cantidad         Decimal   @db.Decimal(12, 2)
  signo            Int       @db.SmallInt // 1 | -1
  costoUnitario    Decimal?  @map("costo_unitario") @db.Decimal(12, 2)
  precioUnitario   Decimal?  @map("precio_unitario") @db.Decimal(12, 2)
  motivo           String?
  ubicacionOrigen  String?   @map("ubicacion_origen") // texto libre en el legacy, no FK
  ubicacionDestino String?   @map("ubicacion_destino")
  referenciaId     String?   @map("referencia_id") @db.Uuid // polimórfico: venta_id/compra_id/etc. según `tipo`, sin FK
  fecha            DateTime  @default(now())
  deletedAt        DateTime? @map("deleted_at")

  empresa  Empresa           @relation(fields: [empresaId], references: [id])
  producto Producto          @relation(fields: [productoId], references: [id])
  variante ProductoVariante? @relation(fields: [varianteId], references: [id])
  lote     Lote?             @relation(fields: [loteId], references: [id])
  usuario  Usuario           @relation(fields: [usuarioId], references: [id])

  @@index([empresaId, productoId, fecha])
  @@index([referenciaId]) // movimientos de un documento (anular venta/compra, remito)
  /// Stock y valorización sumando movimientos sin leer la tabla (index-only scan).
  @@index([empresaId, productoId, deletedAt, cantidad, signo, varianteId, tipo, referenciaId, fecha], map: "movimientos_inventario_stock_idx")
  @@map("movimientos_inventario")
}

// ==== Ventas (+items, +cuotas, +devoluciones) ====

model VentaNumeracion {
  empresaId String @id @map("empresa_id") @db.Uuid
  ultimo    BigInt @default(0)

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("ventas_numeracion")
}

model Venta {
  id                 String    @id @default(uuid()) @db.Uuid
  empresaId          String    @map("empresa_id") @db.Uuid
  usuarioId          String    @map("usuario_id") @db.Uuid
  clienteId          String?   @map("cliente_id") @db.Uuid
  numeroVenta        String?   @map("numero_venta")
  fecha              DateTime  @default(now())
  formaPago          String    @map("forma_pago") // efectivo | transferencia | debito | credito | qr
  descuento          Decimal   @default(0) @db.Decimal(12, 2)
  clienteNombre      String?   @map("cliente_nombre")
  canal              String?   @default("mostrador")
  notas              String?
  cuotas             Int       @default(1)
  coeficienteInteres Decimal   @default(0) @map("coeficiente_interes") @db.Decimal(5, 2)
  totalSinInteres    Decimal?  @map("total_sin_interes") @db.Decimal(12, 2)
  totalConInteres    Decimal?  @map("total_con_interes") @db.Decimal(12, 2)
  // Señas (068_senias.sql) — preservado literal, Analytics cuenta lo COBRADO.
  esSenia            Boolean   @default(false) @map("es_senia")
  montoSenia         Decimal   @default(0) @map("monto_senia") @db.Decimal(12, 2)
  saldoPendiente     Decimal   @default(0) @map("saldo_pendiente") @db.Decimal(12, 2)
  estadoCobro        String    @default("pagado") @map("estado_cobro") // pagado | señado | saldo_pendiente
  fechaCobroSaldo    DateTime? @map("fecha_cobro_saldo")
  /// Lista de precios con la que se vendió (null = precio normal).
  listaPrecioId      String?   @map("lista_precio_id") @db.Uuid
  deletedAt          DateTime? @map("deleted_at")

  empresa         Empresa           @relation(fields: [empresaId], references: [id])
  usuario         Usuario           @relation(fields: [usuarioId], references: [id])
  cliente         Cliente?          @relation(fields: [clienteId], references: [id])
  listaPrecio     ListaPrecio?      @relation(fields: [listaPrecioId], references: [id])
  items           VentaItem[]
  anulacion       Anulacion?
  devoluciones    Devolucion[]
  cobrosAplicados CobroAplicacion[]

  pedido Pedido?

  @@index([empresaId, fecha])
  @@index([clienteId]) // historial de compras de un cliente
  @@map("ventas")
}

model VentaItem {
  id             String  @id @default(uuid()) @db.Uuid
  ventaId        String  @map("venta_id") @db.Uuid
  empresaId      String  @map("empresa_id") @db.Uuid
  productoId     String  @map("producto_id") @db.Uuid
  varianteId     String? @map("variante_id") @db.Uuid
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(12, 2)
  costoUnitario  Decimal @default(0) @map("costo_unitario") @db.Decimal(12, 2)

  venta    Venta             @relation(fields: [ventaId], references: [id])
  empresa  Empresa           @relation(fields: [empresaId], references: [id])
  producto Producto          @relation(fields: [productoId], references: [id])
  variante ProductoVariante? @relation(fields: [varianteId], references: [id])

  @@index([ventaId])
  @@index([empresaId])
  @@index([productoId]) // ventas de un producto (más vendidos, combos, ficha)
  @@map("ventas_items")
}

model Anulacion {
  id        String   @id @default(uuid()) @db.Uuid
  empresaId String   @map("empresa_id") @db.Uuid
  ventaId   String   @unique @map("venta_id") @db.Uuid
  usuarioId String?  @map("usuario_id") @db.Uuid
  motivo    String
  createdAt DateTime @default(now()) @map("created_at")

  empresa Empresa  @relation(fields: [empresaId], references: [id])
  venta   Venta    @relation(fields: [ventaId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("anulaciones")
}

model Devolucion {
  id        String    @id @default(uuid()) @db.Uuid
  empresaId String    @map("empresa_id") @db.Uuid
  usuarioId String?   @map("usuario_id") @db.Uuid
  ventaId   String?   @map("venta_id") @db.Uuid
  numero    Int?
  tipo      String // devolucion | cambio
  motivo    String?
  estado    String    @default("pendiente") // pendiente | procesado | cancelado
  fecha     DateTime  @default(now())
  notas     String?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  empresa Empresa          @relation(fields: [empresaId], references: [id])
  usuario Usuario?         @relation(fields: [usuarioId], references: [id])
  venta   Venta?           @relation(fields: [ventaId], references: [id])
  items   DevolucionItem[]

  @@index([ventaId]) // devoluciones de una venta
  @@map("devoluciones")
}

model DevolucionItem {
  id             String  @id @default(uuid()) @db.Uuid
  devolucionId   String  @map("devolucion_id") @db.Uuid
  productoId     String  @map("producto_id") @db.Uuid
  varianteId     String? @map("variante_id") @db.Uuid
  cantidad       Decimal @db.Decimal(12, 2)
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(12, 2)
  tipo           String // devuelto | entregado (cambio)

  devolucion Devolucion        @relation(fields: [devolucionId], references: [id])
  producto   Producto          @relation(fields: [productoId], references: [id])
  variante   ProductoVariante? @relation(fields: [varianteId], references: [id])

  @@index([devolucionId]) // ítems de una devolución
  @@map("devoluciones_items")
}

// ==== Compras (+items, +costos extra, +OrdenCompra, +Proveedor, +OCR) ====

model Proveedor {
  id                  String    @id @default(uuid()) @db.Uuid
  empresaId           String    @map("empresa_id") @db.Uuid
  nombre              String
  razonSocial         String?   @map("razon_social")
  nombreComercial     String?   @map("nombre_comercial")
  cuit                String?
  condicionAfip       String?   @map("condicion_afip")
  contacto            String?
  nombreVendedor      String?   @map("nombre_vendedor")
  telefono            String?
  email               String?
  productosQueProvee  String?   @map("productos_que_provee")
  condicionesPago     String?   @map("condiciones_pago")
  formasPagoAceptadas String[]  @default([]) @map("formas_pago_aceptadas")
  plazoEntrega        String?   @map("plazo_entrega")
  cbu                 String?
  aliasCbu            String?   @map("alias_cbu")
  banco               String?
  notas               String?
  activo              Boolean   @default(true)
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  empresa       Empresa                @relation(fields: [empresaId], references: [id])
  compras       Compra[]
  ordenesCompra OrdenCompra[]
  pagos         MovimientoFinanciero[]
  lotes         Lote[]

  @@index([empresaId, nombre])
  @@map("proveedores")
}

model Compra {
  id                     String    @id @default(uuid()) @db.Uuid
  empresaId              String    @map("empresa_id") @db.Uuid
  usuarioId              String?   @map("usuario_id") @db.Uuid
  proveedorNombre        String?   @map("proveedor") // legado texto libre; ver proveedorId
  proveedorId            String?   @map("proveedor_id") @db.Uuid
  ordenCompraId          String?   @map("orden_compra_id") @db.Uuid
  fecha                  DateTime  @default(now()) @db.Date
  total                  Decimal?  @db.Decimal(12, 2)
  // Costos reales (068/069_costos_compras.sql)
  costoFlete             Decimal   @default(0) @map("costo_flete") @db.Decimal(12, 2)
  costoImpuestos         Decimal   @default(0) @map("costo_impuestos") @db.Decimal(12, 2)
  costoOtros             Decimal   @default(0) @map("costo_otros") @db.Decimal(12, 2)
  descripcionOtros       String?   @map("descripcion_otros")
  totalCostosAdicionales Decimal?  @map("total_costos_adicionales") @db.Decimal(12, 2) // GENERATED ALWAYS en el legacy; recalcular en servicio o vista
  totalReal              Decimal   @default(0) @map("total_real") @db.Decimal(12, 2)
  // Compra a crédito / cuenta corriente: no sale plata al comprar, queda
  // como deuda con el proveedor hasta que se registra el pago
  // (MovimientoFinanciero tipo pago_proveedor).
  aCredito               Boolean   @default(false) @map("a_credito")
  // OCR (071_ocr_facturas.sql)
  imagenFacturaUrl       String?   @map("imagen_factura_url")
  notas                  String?
  deletedAt              DateTime? @map("deleted_at")
  createdAt              DateTime  @default(now()) @map("created_at")

  empresa     Empresa      @relation(fields: [empresaId], references: [id])
  usuario     Usuario?     @relation(fields: [usuarioId], references: [id])
  proveedor   Proveedor?   @relation(fields: [proveedorId], references: [id])
  ordenCompra OrdenCompra? @relation(fields: [ordenCompraId], references: [id])
  items       CompraItem[]

  @@index([empresaId, fecha])
  @@index([proveedorId]) // compras de un proveedor
  @@map("compras")
}

model CompraItem {
  id             String  @id @default(uuid()) @db.Uuid
  compraId       String  @map("compra_id") @db.Uuid
  empresaId      String  @map("empresa_id") @db.Uuid
  productoId     String? @map("producto_id") @db.Uuid
  varianteId     String? @map("variante_id") @db.Uuid
  productoNombre String  @map("producto_nombre")
  cantidad       Int
  costoUnitario  Decimal @map("costo_unitario") @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  compra   Compra            @relation(fields: [compraId], references: [id])
  empresa  Empresa           @relation(fields: [empresaId], references: [id])
  producto Producto?         @relation(fields: [productoId], references: [id])
  variante ProductoVariante? @relation(fields: [varianteId], references: [id])

  @@index([compraId])
  @@index([productoId]) // compras de un producto
  @@map("compras_items")
}

model OrdenCompraNumeracion {
  empresaId String @id @map("empresa_id") @db.Uuid
  ultimo    BigInt @default(0)

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("ordenes_compra_numeracion")
}

model OrdenCompra {
  id                   String    @id @default(uuid()) @db.Uuid
  empresaId            String    @map("empresa_id") @db.Uuid
  proveedorId          String?   @map("proveedor_id") @db.Uuid
  numeroOc             String    @map("numero_oc")
  estado               String    @default("borrador") // borrador | enviada | confirmada | recibida_parcial | recibida | cancelada
  fechaEmision         DateTime? @map("fecha_emision") @db.Date
  fechaEntregaEstimada DateTime? @map("fecha_entrega_estimada") @db.Date
  notas                String?
  total                Decimal   @default(0) @db.Decimal(12, 2)
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")

  empresa   Empresa           @relation(fields: [empresaId], references: [id])
  proveedor Proveedor?        @relation(fields: [proveedorId], references: [id])
  items     OrdenCompraItem[]
  compras   Compra[]

  @@map("ordenes_compra")
}

model OrdenCompraItem {
  id               String  @id @default(uuid()) @db.Uuid
  ordenCompraId    String  @map("orden_compra_id") @db.Uuid
  productoId       String  @map("producto_id") @db.Uuid
  varianteId       String? @map("variante_id") @db.Uuid
  cantidadPedida   Decimal @map("cantidad_pedida") @db.Decimal(12, 2)
  precioUnitario   Decimal @map("precio_unitario") @db.Decimal(12, 2)
  cantidadRecibida Decimal @default(0) @map("cantidad_recibida") @db.Decimal(12, 2)
  recibido         Boolean @default(false)

  ordenCompra OrdenCompra       @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  producto    Producto          @relation(fields: [productoId], references: [id])
  variante    ProductoVariante? @relation(fields: [varianteId], references: [id])

  @@map("ordenes_compra_items")
}

// ==== Pedidos (+items, +asignación, +remitente) ====

model PedidoNumeracion {
  empresaId String @id @map("empresa_id") @db.Uuid
  ultimo    BigInt @default(0)

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("pedidos_numeracion")
}

model Pedido {
  id                 String   @id @default(uuid()) @db.Uuid
  empresaId          String   @map("empresa_id") @db.Uuid
  numeroPedido       String   @map("numero_pedido")
  clienteId          String?  @map("cliente_id") @db.Uuid
  clienteNombre      String?  @map("cliente_nombre")
  clienteEmail       String?  @map("cliente_email")
  clienteTelefono    String?  @map("cliente_telefono")
  origen             String   @default("manual") // manual | tienda_online | importacion
  estado             String   @default("nuevo") // nuevo | en_preparacion | listo_despacho | despachado | con_transportista | entregado | cancelado
  direccionEnvio     String?  @map("direccion_envio")
  codigoPostal       String?  @map("codigo_postal")
  localidad          String?
  provincia          String?
  metodoEnvio        String?  @map("metodo_envio")
  numeroSeguimiento  String?  @map("numero_seguimiento")
  transportista      String?
  notas              String?
  // Remitente (053_pedidos_remitente.sql)
  remitenteNombre    String?  @map("remitente_nombre")
  remitenteDireccion String?  @map("remitente_direccion")
  remitenteTelefono  String?  @map("remitente_telefono")
  remitenteEmail     String?  @map("remitente_email")
  asignadoAId        String?  @map("asignado_a") @db.Uuid
  // Descuentos de la tienda online (la oferta ya va en el precio de cada ítem; acá queda cuánto fue).
  cuponCodigo            String?  @map("cupon_codigo") @db.VarChar(40)
  descuentoOfertas       Decimal  @default(0) @map("descuento_ofertas") @db.Decimal(12, 2)
  descuentoCupon         Decimal  @default(0) @map("descuento_cupon") @db.Decimal(12, 2)
  descuentoTransferencia Decimal  @default(0) @map("descuento_transferencia") @db.Decimal(12, 2)
  /// transferencia | a_coordinar (lo que eligió el cliente en la tienda)
  formaPagoTienda        String?  @map("forma_pago_tienda") @db.VarChar(20)
  // Venta generada al despachar (ingreso + costo del pedido); null antes del despacho.
  ventaId            String?  @unique @map("venta_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")

  empresa   Empresa      @relation(fields: [empresaId], references: [id])
  venta     Venta?       @relation(fields: [ventaId], references: [id])
  cliente   Cliente?     @relation(fields: [clienteId], references: [id])
  asignadoA Usuario?     @relation("PedidoAsignadoA", fields: [asignadoAId], references: [id])
  items     PedidoItem[]

  @@map("pedidos")
}

model PedidoItem {
  id                String  @id @default(uuid()) @db.Uuid
  pedidoId          String  @map("pedido_id") @db.Uuid
  productoId        String  @map("producto_id") @db.Uuid
  varianteId        String? @map("variante_id") @db.Uuid
  loteId            String? @map("lote_id") @db.Uuid
  cantidad          Decimal @db.Decimal(12, 2)
  precioUnitario    Decimal @map("precio_unitario") @db.Decimal(12, 2)
  cantidadPreparada Decimal @default(0) @map("cantidad_preparada") @db.Decimal(12, 2)
  preparado         Boolean @default(false)

  pedido   Pedido            @relation(fields: [pedidoId], references: [id])
  producto Producto          @relation(fields: [productoId], references: [id])
  variante ProductoVariante? @relation(fields: [varianteId], references: [id])
  lote     Lote?             @relation(fields: [loteId], references: [id])

  @@index([pedidoId]) // ítems de un pedido
  @@map("pedidos_items")
}

// ==== Clientes / CRM ====

model Cliente {
  id            String    @id @default(uuid()) @db.Uuid
  empresaId     String    @map("empresa_id") @db.Uuid
  nombre        String
  telefono      String?
  email         String?
  cumpleanos    DateTime? @db.Date
  notasLibres   String?   @map("notas_libres")
  etiquetas     String[]  @default([])
  /// Lista de precios que se le aplica al venderle (null = precio normal).
  listaPrecioId String?   @map("lista_precio_id") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  empresa       Empresa              @relation(fields: [empresaId], references: [id])
  listaPrecio   ListaPrecio?         @relation(fields: [listaPrecioId], references: [id])
  interacciones ClienteInteraccion[]
  ventas        Venta[]
  cobros        CobroCliente[]
  pedidos       Pedido[]

  cuentaTienda  CuentaTienda?
  @@index([empresaId])
  @@map("clientes")
}

// Nota, preferencia, dato personal, etc. — usado también como base de
// "segmentos" (VIP, en riesgo...) que en el legacy se calculan al vuelo en
// segmentos_clientes(), no se persisten como tabla propia.
model ClienteInteraccion {
  id        String   @id @default(uuid()) @db.Uuid
  clienteId String   @map("cliente_id") @db.Uuid
  empresaId String   @map("empresa_id") @db.Uuid
  tipo      String // nota | preferencia | dato_personal | queja | cumplido | seguimiento
  contenido String
  privado   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  cliente Cliente @relation(fields: [clienteId], references: [id])
  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("clientes_interacciones")
}

model Difusion {
  id                    String    @id @default(uuid()) @db.Uuid
  empresaId             String    @map("empresa_id") @db.Uuid
  usuarioId             String?   @map("usuario_id") @db.Uuid
  segmento              String
  mensaje               String
  cantidadDestinatarios Int       @default(0) @map("cantidad_destinatarios")
  fecha                 DateTime  @default(now())
  deletedAt             DateTime? @map("deleted_at")

  empresa Empresa  @relation(fields: [empresaId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("difusiones")
}

// ==== Contabilidad (Gasto; los datos fiscales viven en ConfiguracionEmpresa) ====

model Gasto {
  id          String    @id @default(uuid()) @db.Uuid
  empresaId   String    @map("empresa_id") @db.Uuid
  usuarioId   String?   @map("usuario_id") @db.Uuid
  categoria   String // alquiler | sueldos | servicios | marketing | logistica | impuestos | mantenimiento | otro
  descripcion String
  monto       Decimal   @db.Decimal(12, 2)
  fecha       DateTime  @default(now()) @db.Date
  recurrente  Boolean   @default(false)
  frecuencia  String? // mensual | quincenal | semanal
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  empresa Empresa  @relation(fields: [empresaId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([empresaId, fecha])
  @@map("gastos")
}

/// Movimientos de dinero y patrimonio que no son ventas, compras ni gastos:
/// la base del Balance, la Evolución del Patrimonio Neto y el Flujo de Efectivo.
model MovimientoFinanciero {
  id            String    @id @default(uuid()) @db.Uuid
  empresaId     String    @map("empresa_id") @db.Uuid
  usuarioId     String?   @map("usuario_id") @db.Uuid
  /// arqueo (cuánta plata había ese día) | aporte | retiro | prestamo_recibido
  /// | prestamo_pago | bien_uso | pago_proveedor
  tipo          String
  monto         Decimal   @db.Decimal(14, 2)
  fecha         DateTime  @db.Date
  descripcion   String
  proveedorId   String?   @map("proveedor_id") @db.Uuid
  /// bien_uso: meses en que se amortiza (lineal).
  vidaUtilMeses Int?      @map("vida_util_meses")
  /// bien_uso: false = ya era del dueño (aporte en especie), no sale plata de la caja.
  conCaja       Boolean   @default(true) @map("con_caja")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  usuario   Usuario?   @relation(fields: [usuarioId], references: [id])
  proveedor Proveedor? @relation(fields: [proveedorId], references: [id])

  @@index([empresaId, fecha])
  @@map("movimientos_financieros")
}

/// Topes de ingresos brutos anuales del monotributo por categoría. Los
/// actualiza ARCA dos veces por año: se cargan desde la consola de Admin con
/// su fecha de vigencia y se usa la vigente más reciente.
model MonotributoTope {
  id            String   @id @default(uuid()) @db.Uuid
  vigenciaDesde DateTime @map("vigencia_desde") @db.Date
  categoria     String
  topeAnual     Decimal  @map("tope_anual") @db.Decimal(16, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([vigenciaDesde, categoria])
  @@map("monotributo_topes")
}

// ==== Soporte ====

model Ticket {
  id             String    @id @default(uuid()) @db.Uuid
  empresaId      String    @map("empresa_id") @db.Uuid
  usuarioId      String?   @map("usuario_id") @db.Uuid
  numeroTicket   String?   @unique @map("numero_ticket")
  asunto         String
  descripcion    String
  categoria      String    @default("consulta") // consulta | bug | sugerencia | facturacion | otro
  prioridad      String    @default("media") // baja | media | alta | urgente
  estado         String    @default("abierto") // abierto | en_proceso | resuelto | cerrado
  vistoClienteAt DateTime? @map("visto_cliente_at")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  empresa    Empresa           @relation(fields: [empresaId], references: [id])
  usuario    Usuario?          @relation(fields: [usuarioId], references: [id])
  respuestas TicketRespuesta[]

  @@map("tickets")
}

model TicketRespuesta {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  autorId   String?  @map("autor_id") @db.Uuid
  esAdmin   Boolean  @default(false) @map("es_admin")
  contenido String
  createdAt DateTime @default(now()) @map("created_at")

  ticket Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  autor  Usuario? @relation(fields: [autorId], references: [id])

  @@index([ticketId, createdAt])
  @@map("tickets_respuestas")
}

// Numeración GLOBAL (no por empresa, a diferencia de VentaNumeracion/
// PedidoNumeracion) - fiel a tickets_numero_seq en
// supabase/039_tickets_soporte.sql, una secuencia de Postgres compartida
// por todo el SaaS. Fila única (id fijo en 1) en vez de una secuencia
// nativa de Postgres, para seguir el mismo patrón upsert-increment que ya
// usan los otros numeradores de este schema.
model TicketNumeracion {
  id     Int    @id @default(1)
  ultimo BigInt @default(0)

  @@map("tickets_numeracion")
}

// ==== Admin SaaS ====

model Pago {
  id        String    @id @default(uuid()) @db.Uuid
  empresaId String    @map("empresa_id") @db.Uuid
  /// Monto cobrado (con el descuento ya aplicado), sin IVA.
  montoArs  Decimal   @map("monto_ars") @db.Decimal(12, 2)
  metodo    String
  /// confirmado | devuelto
  estado    String    @default("confirmado")
  periodo   DateTime? @db.Date
  notas     String?
  /// Plan y ciclo pagados (basico | pro | ecommerce; mensual | trimestral | anual).
  plan              String?
  ciclo             String?
  /// Período que cubre este pago [desde, hasta).
  periodoDesde      DateTime? @map("periodo_desde") @db.Date
  periodoHasta      DateTime? @map("periodo_hasta") @db.Date
  /// Cuotas: número de cuota, total de cuotas y el grupo que une las cuotas de un mismo período.
  cuota             Int?
  cuotas            Int?
  grupoId           String?   @map("grupo_id") @db.Uuid
  /// entrada (primer período pago) | renovacion
  tipoPeriodo       String?   @map("tipo_periodo")
  /// Precio de lista de lo que cubre este pago y el descuento aplicado (lista − descuento = monto).
  precioLista       Decimal?  @map("precio_lista") @db.Decimal(12, 2)
  descuentoArs      Decimal?  @map("descuento_ars") @db.Decimal(12, 2)
  cuponId           String?   @map("cupon_id") @db.Uuid
  /// sin_cupon | entrada | renovacion | sin_descuento | manual
  reglaAplicada     String?   @map("regla_aplicada")
  /// manual (lo carga el admin) | mercadopago
  origen            String    @default("manual")
  referenciaExterna String?   @map("referencia_externa")
  devueltoEn        DateTime? @map("devuelto_en")
  devolucionMotivo  String?   @map("devolucion_motivo")
  createdAt DateTime  @default(now()) @map("created_at")

  empresa    Empresa    @relation(fields: [empresaId], references: [id])
  cupon      Cupon?     @relation(fields: [cuponId], references: [id])
  comisiones Comision[]
  cuotaProgramada CuotaProgramada?

  @@index([empresaId, createdAt])
  @@map("pagos")
}

// ==== Equipo / Invitaciones (rol contador incluido, 070_rol_contador.sql) ====

model InvitacionColaborador {
  id          String   @id @default(uuid()) @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  email       String
  rol         RolCrudo @default(operario) // administrador | operario | contador (CHECK final tras 070)
  invitadoPor String?  @map("invitado_por") @db.Uuid
  pendiente   Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId, pendiente])
  @@map("invitaciones_colaboradores")
}

// Permisos granulares de operador/colaborador — dueño y contador tienen su
// acceso resuelto en código (ver MODULOS_CONTADOR/ACCIONES_CONTADOR en
// apps/api/src/common/auth/rol.types.ts), esta tabla es solo para operador.
model ColaboradorPermiso {
  id        String   @id @default(uuid()) @db.Uuid
  empresaId String   @map("empresa_id") @db.Uuid
  usuarioId String   @unique @map("usuario_id") @db.Uuid
  modulos   Json     @default("{}") // Record<ModuloClave, boolean>
  acciones  Json     @default("{}") // Record<AccionClave, boolean>
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  empresa Empresa @relation(fields: [empresaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("colaborador_permisos")
}

/// Lista de precios (ej. Mayorista -15%): ajuste sobre el precio de venta normal.
model ListaPrecio {
  id        String    @id @default(uuid()) @db.Uuid
  empresaId String    @map("empresa_id") @db.Uuid
  nombre    String
  /// % sobre el precio normal: -15 = 15% menos, +10 = 10% más.
  ajustePct Decimal   @map("ajuste_pct") @db.Decimal(6, 2)
  /// Redondear hacia arriba a este múltiplo (0 = sin redondeo).
  redondeo  Int       @default(0)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  empresa  Empresa   @relation(fields: [empresaId], references: [id])
  clientes Cliente[]
  ventas   Venta[]

  @@index([empresaId])
  @@map("listas_precios")
}

/// Avisos para la consola de administración (registros nuevos, etc.).
model AvisoAdmin {
  id        String   @id @default(uuid()) @db.Uuid
  /// registro | ...
  tipo      String
  titulo    String
  detalle   Json     @default("{}")
  empresaId String?  @map("empresa_id") @db.Uuid
  leido     Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  empresa Empresa? @relation(fields: [empresaId], references: [id])

  @@index([leido, createdAt])
  @@map("avisos_admin")
}

/// Receta / ficha de fabricación de un producto (o variante): qué insumos lleva por unidad.
model Receta {
  id            String    @id @default(uuid()) @db.Uuid
  empresaId     String    @map("empresa_id") @db.Uuid
  productoId    String    @map("producto_id") @db.Uuid
  varianteId    String?   @map("variante_id") @db.Uuid
  /// Minutos de trabajo por unidad (costo = minutos × valor hora de la empresa).
  minutos       Decimal   @default(0) @db.Decimal(8, 2)
  /// Kit que se arma al vender: no tiene stock propio, la venta descuenta sus componentes.
  armarAlVender Boolean   @default(false) @map("armar_al_vender")
  notas         String?
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  empresa  Empresa           @relation(fields: [empresaId], references: [id])
  producto Producto          @relation("RecetaProducto", fields: [productoId], references: [id])
  items    RecetaItem[]
  ordenes  OrdenProduccion[]

  @@index([empresaId])
  @@map("recetas")
}

model RecetaItem {
  id               String  @id @default(uuid()) @db.Uuid
  recetaId         String  @map("receta_id") @db.Uuid
  insumoId         String  @map("insumo_id") @db.Uuid
  insumoVarianteId String? @map("insumo_variante_id") @db.Uuid
  /// Cantidad por unidad fabricada, en la unidad del insumo.
  cantidad         Decimal @db.Decimal(12, 4)

  receta Receta   @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  insumo Producto @relation("RecetaInsumo", fields: [insumoId], references: [id])

  @@index([recetaId])
  @@map("recetas_items")
}

/// Orden de producción: fabricar N unidades descuenta insumos y suma producto terminado.
model OrdenProduccion {
  id              String    @id @default(uuid()) @db.Uuid
  empresaId       String    @map("empresa_id") @db.Uuid
  numero          Int
  recetaId        String    @map("receta_id") @db.Uuid
  productoId      String    @map("producto_id") @db.Uuid
  varianteId      String?   @map("variante_id") @db.Uuid
  cantidad        Decimal   @db.Decimal(12, 2)
  /// terminada | anulada
  estado          String    @default("terminada")
  /// Costo de materiales de toda la orden (lo que pasa al valor del stock).
  costoMateriales Decimal   @map("costo_materiales") @db.Decimal(14, 2)
  /// Mano de obra de toda la orden (informativo, para precios).
  costoManoObra   Decimal   @default(0) @map("costo_mano_obra") @db.Decimal(14, 2)
  ubicacion       String?
  notas           String?
  usuarioId       String    @map("usuario_id") @db.Uuid
  fecha           DateTime  @default(now())
  anuladaAt       DateTime? @map("anulada_at")

  empresa  Empresa  @relation(fields: [empresaId], references: [id])
  receta   Receta   @relation(fields: [recetaId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@unique([empresaId, numero])
  @@index([empresaId, fecha])
  @@map("ordenes_produccion")
}

/// Cobro de un saldo (cuenta corriente / seña): lo que pagó el cliente, cuándo y cómo.
model CobroCliente {
  id        String    @id @default(uuid()) @db.Uuid
  empresaId String    @map("empresa_id") @db.Uuid
  clienteId String?   @map("cliente_id") @db.Uuid
  monto     Decimal   @db.Decimal(12, 2)
  formaPago String    @map("forma_pago")
  fecha     DateTime
  notas     String?
  usuarioId String    @map("usuario_id") @db.Uuid
  anuladoAt DateTime? @map("anulado_at")
  createdAt DateTime  @default(now()) @map("created_at")

  empresa      Empresa           @relation(fields: [empresaId], references: [id])
  cliente      Cliente?          @relation(fields: [clienteId], references: [id])
  aplicaciones CobroAplicacion[]

  @@index([empresaId, fecha])
  @@index([clienteId])
  @@map("cobros_clientes")
}

/// A qué ventas se aplicó cada cobro (las más viejas primero).
model CobroAplicacion {
  id      String  @id @default(uuid()) @db.Uuid
  cobroId String  @map("cobro_id") @db.Uuid
  ventaId String  @map("venta_id") @db.Uuid
  monto   Decimal @db.Decimal(12, 2)

  cobro CobroCliente @relation(fields: [cobroId], references: [id])
  venta Venta        @relation(fields: [ventaId], references: [id])

  @@index([cobroId])
  @@index([ventaId])
  @@map("cobros_aplicaciones")
}

/// Tienda online de la empresa: dirección, marca, contacto y datos de pago.
model TiendaConfig {
  id              String   @id @default(uuid()) @db.Uuid
  empresaId       String   @unique @map("empresa_id") @db.Uuid
  activa          Boolean  @default(false)
  /// acacia -> acacia.analitica360.app (único, minúsculas, letras/números/guiones).
  subdominio      String   @unique
  /// Dominio propio conectado (ej. acaciamates.com.ar), opcional.
  dominioPropio   String?  @unique @map("dominio_propio")
  nombre          String
  descripcion     String?
  /// Color principal de la marca (#RRGGBB).
  color           String   @default("#6366f1")
  logoUrl         String?  @map("logo_url")
  whatsapp        String?
  instagram       String?
  textoEnvios     String?  @map("texto_envios")
  /// Datos para transferir (se muestran al confirmar el pedido).
  alias           String?
  cbu             String?
  titular         String?
  mostrarSinStock Boolean  @default(true) @map("mostrar_sin_stock")
  /// Estética: textura de fondo (puntos, lienzo, papel, rayas, ondas, liso),
  /// tipografía de títulos (clasica, elegante, moderna, amigable) y bordes
  /// (redondeados, suaves, rectos).
  fondo           String   @default("puntos")
  tipografia      String   @default("clasica")
  bordes          String   @default("redondeados")
  /// Foto grande de la portada (opcional; si no hay, se usa una foto de producto).
  portadaUrl      String?  @map("portada_url")
  /// Franja de anuncio arriba de todo (ej. "Envío gratis desde $50.000").
  anuncio         String?
  /// Forma de las fotos de producto (cuadrada, vertical, horizontal) y productos por fila en el celular (1 o 2).
  formaFoto        String   @default("horizontal") @map("forma_foto")
  columnasCelular  Int      @default(1) @map("columnas_celular")
  /// Secciones de la portada que no se muestran (beneficios, categorias, destacados, sobre).
  seccionesOcultas String[] @default([]) @map("secciones_ocultas")
  tituloDestacados String?  @map("titulo_destacados")
  sobreNosotros    String?  @map("sobre_nosotros")
  horario          String?
  facebook         String?
  tiktok           String?
  /// Monto mínimo de compra en la tienda (null = sin mínimo).
  /// % de descuento si paga por transferencia (0 = sin descuento).
  descuentoTransferencia Decimal @default(0) @map("descuento_transferencia") @db.Decimal(5, 2)
  pedidoMinimo     Decimal? @map("pedido_minimo") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("tiendas_config")
}

/// Fotos de un producto (la primera es la principal).
model ProductoImagen {
  id         String   @id @default(uuid()) @db.Uuid
  empresaId  String   @map("empresa_id") @db.Uuid
  productoId String   @map("producto_id") @db.Uuid
  url        String
  /// Clave en el almacenamiento (para poder borrarla).
  clave      String
  /// Versión chica para listados (las fotos se guardan optimizadas en WEBP).
  urlMiniatura   String? @map("url_miniatura")
  claveMiniatura String? @map("clave_miniatura")
  orden      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  empresa  Empresa  @relation(fields: [empresaId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@index([productoId, orden])
  @@map("productos_imagenes")
}


// ==== Alianzas con cámaras y cupones ====
// Reglas de cálculo en src/modules/alianzas/alianzas.util.ts.

/// Cámara o aliado que nos trae clientes y cobra comisión por ellos.
model Camara {
  id               String   @id @default(uuid()) @db.Uuid
  nombre           String
  contactoNombre   String?  @map("contacto_nombre")
  contactoEmail    String?  @map("contacto_email")
  contactoTelefono String?  @map("contacto_telefono")
  activa           Boolean  @default(true)
  /// Meses de comisión por cliente desde su primer pago.
  mesesComision    Int      @default(24) @map("meses_comision")
  /// Tramos por número de orden: [{ desde, hasta (null = sin tope), porcentaje }].
  tramos           Json
  notas            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  cupones       Cupon[]
  empresas      Empresa[]
  comisiones    Comision[]
  liquidaciones Liquidacion[]

  @@map("camaras")
}

/// Cupón o código: de cámara, de descuento o de referido.
model Cupon {
  id                 String    @id @default(uuid()) @db.Uuid
  /// Normalizado: sin espacios y en mayúsculas ("ucim 360" → "UCIM360").
  codigo             String    @unique
  /// camara | descuento | referido
  tipo               String
  camaraId           String?   @map("camara_id") @db.Uuid
  /// Referidos: la empresa que recomienda (la lógica se arma más adelante).
  empresaReferenteId String?   @map("empresa_referente_id") @db.Uuid
  descripcion        String?
  /// Días de prueba gratis (reemplazan a los 14 comunes); null = la prueba común.
  diasPrueba         Int?      @map("dias_prueba")
  /// Por ciclo (mensual | trimestral | anual): { entrada: [{ meses, porcentaje }], periodosEntrada, renovacionPct, renovacionPeriodos, cuotas }.
  reglas             Json      @default("{}")
  desde              DateTime? @db.Date
  hasta              DateTime? @db.Date
  maxUsos            Int?      @map("max_usos")
  usos               Int       @default(0)
  activo             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  camara           Camara?    @relation(fields: [camaraId], references: [id])
  empresaReferente Empresa?   @relation("CuponReferente", fields: [empresaReferenteId], references: [id])
  usosRegistro     CuponUso[]
  empresas         Empresa[]  @relation("EmpresaCupon")
  pagos            Pago[]

  @@index([camaraId])
  @@map("cupones")
}

/// Cada uso de un cupón: quién y cuándo. Controla que el mes gratis sea de un solo uso.
model CuponUso {
  id          String   @id @default(uuid()) @db.Uuid
  cuponId     String   @map("cupon_id") @db.Uuid
  empresaId   String?  @map("empresa_id") @db.Uuid
  clerkUserId String?  @map("clerk_user_id")
  email       String?
  cuit        String?
  /// Recibió la prueba extendida del cupón.
  conPrueba   Boolean  @default(false) @map("con_prueba")
  createdAt   DateTime @default(now()) @map("created_at")

  cupon Cupon @relation(fields: [cuponId], references: [id])

  @@index([email])
  @@index([clerkUserId])
  @@index([cuit])
  @@index([empresaId])
  @@map("cupones_usos")
}

/// Una línea por pago que genera comisión (o ajuste negativo por devolución). No se recalculan.
model Comision {
  id            String    @id @default(uuid()) @db.Uuid
  camaraId      String    @map("camara_id") @db.Uuid
  empresaId     String    @map("empresa_id") @db.Uuid
  pagoId        String    @map("pago_id") @db.Uuid
  /// pago | ajuste
  tipo          String
  base          Decimal   @db.Decimal(12, 2)
  /// Parte del período pagado que cae dentro de la ventana de comisión (0 a 1).
  proporcion    Decimal   @db.Decimal(9, 6)
  porcentaje    Decimal   @db.Decimal(5, 2)
  monto         Decimal   @db.Decimal(12, 2)
  periodoDesde  DateTime? @map("periodo_desde") @db.Date
  periodoHasta  DateTime? @map("periodo_hasta") @db.Date
  /// Mes (día 1) en que se liquida: el del cobro, o el de la devolución para los ajustes.
  mes           DateTime  @db.Date
  liquidacionId String?   @map("liquidacion_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")

  camara      Camara       @relation(fields: [camaraId], references: [id])
  empresa     Empresa      @relation(fields: [empresaId], references: [id])
  pago        Pago         @relation(fields: [pagoId], references: [id])
  liquidacion Liquidacion? @relation(fields: [liquidacionId], references: [id])

  @@unique([pagoId, tipo])
  @@index([camaraId, mes])
  @@map("comisiones")
}

/// Liquidación mensual de una cámara: pendiente → aprobada → pagada.
model Liquidacion {
  id          String    @id @default(uuid()) @db.Uuid
  camaraId    String    @map("camara_id") @db.Uuid
  mes         DateTime  @db.Date
  estado      String    @default("pendiente")
  total       Decimal   @default(0) @db.Decimal(12, 2)
  aprobadaEn  DateTime? @map("aprobada_en")
  aprobadaPor String?   @map("aprobada_por")
  pagadaEn    DateTime? @map("pagada_en") @db.Date
  referencia  String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  camara     Camara     @relation(fields: [camaraId], references: [id])
  comisiones Comision[]

  @@unique([camaraId, mes])
  @@map("liquidaciones")
}

/// Corrección manual del origen de un cliente (solo admin), con quién, cuándo y por qué.
model CambioOrigen {
  id               String   @id @default(uuid()) @db.Uuid
  empresaId        String   @map("empresa_id") @db.Uuid
  camaraAnteriorId String?  @map("camara_anterior_id") @db.Uuid
  camaraNuevaId    String?  @map("camara_nueva_id") @db.Uuid
  cuponAnteriorId  String?  @map("cupon_anterior_id") @db.Uuid
  cuponNuevoId     String?  @map("cupon_nuevo_id") @db.Uuid
  motivo           String
  hechoPor         String   @map("hecho_por")
  createdAt        DateTime @default(now()) @map("created_at")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
  @@map("cambios_origen")
}

/// Plan de cuotas de un período (trimestral o anual): cada cuota con su vencimiento.
/// El cobro (manual hoy, Mercado Pago más adelante) toma las pendientes y las marca pagadas.
model CuotaProgramada {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String   @map("empresa_id") @db.Uuid
  /// Une las cuotas de un mismo período (es el grupo_id de sus pagos).
  grupoId      String   @map("grupo_id") @db.Uuid
  numero       Int
  cuotas       Int
  plan         String
  ciclo        String
  /// entrada | renovacion
  tipoPeriodo  String   @map("tipo_periodo")
  cuponId      String?  @map("cupon_id") @db.Uuid
  monto        Decimal  @db.Decimal(12, 2)
  precioLista  Decimal  @map("precio_lista") @db.Decimal(12, 2)
  /// Parte del período que cubre [desde, hasta); vence el día que empieza.
  periodoDesde DateTime @map("periodo_desde") @db.Date
  periodoHasta DateTime @map("periodo_hasta") @db.Date
  vence        DateTime @db.Date
  /// pendiente | pagada
  estado       String   @default("pendiente")
  pagoId       String?  @unique @map("pago_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  empresa Empresa @relation(fields: [empresaId], references: [id])
  pago    Pago?   @relation(fields: [pagoId], references: [id])

  @@unique([grupoId, numero])
  @@index([empresaId])
  @@index([estado, vence])
  @@map("cuotas_programadas")
}

/// Uso de la app (consola → Uso): pantallas que se abren y botones que se tocan.
/// Solo nombres de pantallas y de botones; nunca lo que se escribe. Se guarda 180 días.
model EventoUso {
  id          BigInt   @id @default(autoincrement())
  empresaId   String   @map("empresa_id") @db.Uuid
  usuarioId   String   @map("usuario_id") @db.Uuid
  /// Pestaña del navegador (se renueva al cerrarla).
  sesion      String   @db.VarChar(40)
  /// vista | clic
  tipo        String   @db.VarChar(10)
  /// Ruta sin ids: /ventas/:id
  ruta        String   @db.VarChar(200)
  /// Qué se tocó ("Nueva venta", "Exportar"); null en las vistas.
  objetivo    String?  @db.VarChar(80)
  /// celular | escritorio
  dispositivo String?  @db.VarChar(12)
  creadoEn    DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([creadoEn])
  @@index([usuarioId, creadoEn])
  @@index([empresaId, creadoEn])
  @@map("eventos_uso")
}

/// Bitácora de auditoría: quién cambió qué y cuándo (SOC 2 CC7/CC8, ISO 27001 A.8.15).
/// Solo se agregan filas: un trigger impide editarlas o borrarlas, y cada fila
/// guarda un hash encadenado con la anterior para detectar si alguien la tocó.
/// Sin claves foráneas a propósito: la evidencia queda aunque se borre la empresa.
model RegistroAuditoria {
  id             BigInt   @id @default(autoincrement())
  /// Empresa dueña del dato (null = algo general, ej. un cupón).
  empresaId      String?  @map("empresa_id") @db.Uuid
  actorUsuarioId String?  @map("actor_usuario_id") @db.Uuid
  actorEmpresaId String?  @map("actor_empresa_id") @db.Uuid
  /// usuario | admin | tienda | sistema
  actorTipo      String   @map("actor_tipo") @db.VarChar(10)
  actorNombre    String   @map("actor_nombre") @db.VarChar(160)
  /// crear | editar | borrar | restaurar | anular
  accion         String   @db.VarChar(12)
  /// Modelo de Prisma: Producto, Venta…
  entidad        String   @db.VarChar(40)
  entidadId      String?  @map("entidad_id") @db.VarChar(64)
  entidadNombre  String?  @map("entidad_nombre") @db.VarChar(160)
  resumen        String
  /// { campo: [antes, después] }
  cambios        Json?
  ip             String?  @db.VarChar(64)
  ruta           String?  @db.VarChar(200)
  /// sha256(hash anterior | contenido); lo calcula la base.
  hash           String   @default("") @db.VarChar(64)
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@index([empresaId, creadoEn])
  @@index([entidad, entidadId])
  @@index([actorUsuarioId, creadoEn])
  @@index([creadoEn])
  @@map("registro_auditoria")
}

/// Cupón de descuento de la tienda online de una empresa (ACACIA10). Distinto de
/// `Cupon`, que es de las alianzas de Analítica 360.
model CuponTienda {
  id          String    @id @default(uuid()) @db.Uuid
  empresaId   String    @map("empresa_id") @db.Uuid
  /// En mayúsculas, sin espacios; único por empresa.
  codigo      String    @db.VarChar(40)
  /// porcentaje | monto
  tipo        String    @db.VarChar(10)
  valor       Decimal   @db.Decimal(12, 2)
  compraMinima Decimal? @map("compra_minima") @db.Decimal(12, 2)
  desde       DateTime? @db.Date
  hasta       DateTime? @db.Date
  /// null = sin límite
  usosMax     Int?      @map("usos_max")
  usos        Int       @default(0)
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, codigo])
  @@map("cupones_tienda")
}

/// Cuenta de un comprador en la tienda online de una empresa. Siempre es un
/// Cliente de esa empresa (así el dueño lo ve en Clientes y sus pedidos quedan atados).
model CuentaTienda {
  id            String    @id @default(uuid()) @db.Uuid
  empresaId     String    @map("empresa_id") @db.Uuid
  clienteId     String    @unique @map("cliente_id") @db.Uuid
  /// En minúsculas. Verificado: se entra con un código que llega a ese email (o con Google).
  email         String    @db.VarChar(160)
  googleSub     String?   @map("google_sub") @db.VarChar(64)
  nombre        String?   @db.VarChar(120)
  telefono      String?   @db.VarChar(40)
  calle         String?   @db.VarChar(120)
  numero        String?   @db.VarChar(20)
  piso          String?   @db.VarChar(40)
  ciudad        String?   @db.VarChar(80)
  provincia     String?   @db.VarChar(60)
  codigoPostal  String?   @map("codigo_postal") @db.VarChar(12)
  createdAt     DateTime  @default(now()) @map("created_at")
  ultimoIngreso DateTime? @map("ultimo_ingreso")

  empresa    Empresa          @relation(fields: [empresaId], references: [id])
  cliente    Cliente          @relation(fields: [clienteId], references: [id])
  sesiones   SesionTienda[]
  favoritos  FavoritoTienda[]

  @@unique([empresaId, email])
  @@unique([empresaId, googleSub])
  @@map("cuentas_tienda")
}

/// Código de ingreso por email (6 dígitos). Solo se guarda su hash.
model CodigoIngresoTienda {
  id         String   @id @default(uuid()) @db.Uuid
  empresaId  String   @map("empresa_id") @db.Uuid
  email      String   @db.VarChar(160)
  codigoHash String   @map("codigo_hash") @db.VarChar(64)
  expira     DateTime
  intentos   Int      @default(0)
  usado      Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([empresaId, email, createdAt])
  @@map("codigos_ingreso_tienda")
}

/// Sesión de una cuenta de la tienda: el navegador guarda el token en una cookie httpOnly; acá, su hash.
model SesionTienda {
  id        String   @id @default(uuid()) @db.Uuid
  cuentaId  String   @map("cuenta_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expira    DateTime
  createdAt DateTime @default(now()) @map("created_at")

  cuenta CuentaTienda @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  @@index([cuentaId])
  @@map("sesiones_tienda")
}

model FavoritoTienda {
  cuentaId   String   @map("cuenta_id") @db.Uuid
  productoId String   @map("producto_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  cuenta CuentaTienda @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  @@id([cuentaId, productoId])
  @@map("favoritos_tienda")
}

/// Informes automáticos por email (semanal y mensual, en PDF). Sin fila = los dos activados y solo a los dueños.
model InformesConfig {
  id          String   @id @default(uuid()) @db.Uuid
  empresaId   String   @unique @map("empresa_id") @db.Uuid
  semanal     Boolean  @default(true)
  mensual     Boolean  @default(true)
  /// Otros destinatarios (contador, socio), en minúsculas.
  emailsExtra String[] @default([]) @map("emails_extra")
  /// Bajas desde el link del email, por tipo: "semanal:ana@x.com".
  bajas       String[] @default([])
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("informes_config")
}

/// Cada informe que se mandó (o se intentó): evita mandar dos veces el mismo período.
model InformeEnviado {
  id            String    @id @default(uuid()) @db.Uuid
  empresaId     String    @map("empresa_id") @db.Uuid
  /// semanal | mensual
  tipo          String    @db.VarChar(10)
  desde         DateTime  @db.Date
  hasta         DateTime  @db.Date
  /// enviando | enviado | sin_destinatarios | sin_servicio (falta Resend) | error
  estado        String    @db.VarChar(20)
  destinatarios String[]  @default([])
  error         String?   @db.VarChar(300)
  /// Si falla, se reintenta hasta 3 veces.
  intentos      Int       @default(1)
  creadoEn      DateTime  @default(now()) @map("creado_en")
  enviadoEn     DateTime? @map("enviado_en")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, tipo, desde])
  @@index([creadoEn])
  @@map("informes_enviados")
}

/// Cotización del dólar por día (fuente: api.argentinadatos.com). Los fines de semana y feriados no hay fila: vale la del último día anterior.
model CotizacionDolar {
  /// blue | oficial | bolsa (MEP)
  casa   String   @db.VarChar(10)
  fecha  DateTime @db.Date
  compra Decimal  @db.Decimal(12, 2)
  venta  Decimal  @db.Decimal(12, 2)

  @@id([casa, fecha])
  @@map("cotizaciones_dolar")
}

/// Premio por recomendar: cuando la empresa recomendada hace su primer pago, la que la recomendó
/// gana un % de descuento para su próximo período (se suman; hasta 6 por año).
model PremioReferido {
  id                 String    @id @default(uuid()) @db.Uuid
  empresaReferenteId String    @map("empresa_referente_id") @db.Uuid
  /// Una sola vez por empresa recomendada.
  empresaReferidaId  String    @unique @map("empresa_referida_id") @db.Uuid
  /// El primer pago de la recomendada (si se devuelve antes de usarse, el premio se anula).
  pagoOrigenId       String    @map("pago_origen_id") @db.Uuid
  porcentaje         Decimal   @default(10) @db.Decimal(5, 2)
  /// disponible | usado | tope (pasó el máximo del año: no se usa) | anulado
  estado             String    @default("disponible") @db.VarChar(12)
  /// El pago de la que recomendó en el que se descontó.
  pagoUsoId          String?   @map("pago_uso_id") @db.Uuid
  usadoEn            DateTime? @map("usado_en")
  creadoEn           DateTime  @default(now()) @map("creado_en")

  referente Empresa @relation("PremioReferente", fields: [empresaReferenteId], references: [id])
  referida  Empresa @relation("PremioReferida", fields: [empresaReferidaId], references: [id])

  @@index([empresaReferenteId, estado])
  @@map("premios_referidos")
}
