{
  "name": "analitica-360",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "turbo run build",
    "build:api": "pnpm --filter api build",
    "build:web": "NODE_OPTIONS='--max-old-space-size=2048' pnpm --filter web build",
    "build:prod": "pnpm build:api && pnpm build:web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "auditar": "node scripts/auditoria/auditar.mjs",
    "probar:scraper": "node scripts/probar-scraper.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "dotenv": "^18.0.1",
    "tsx": "^4.23.15",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
