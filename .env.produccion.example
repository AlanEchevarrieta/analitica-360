# Copiar a .env.produccion (ignorado por git) y completar. Lo usa docker-compose.prod.yml.
# En CI/CD estas mismas claves van como "Secrets" / "Variables" del repositorio en GitHub.

# Dominio: en el DNS, apuntar @, www, api y * (comodín, para las tiendas) a la IP del servidor.
DOMINIO=analitica360.app
# Email para los avisos de los certificados HTTPS (Let's Encrypt)
ACME_EMAIL=

# Base de datos (elegir una contraseña larga y aleatoria; nunca la de desarrollo)
POSTGRES_DB=analitica360
POSTGRES_USER=analitica360
POSTGRES_PASSWORD=

# API
CORS_ORIGINS=https://analitica360.app,https://www.analitica360.app
CLERK_SECRET_KEY=
INTERNAL_WEBHOOK_SECRET=
TIENDA_PROXY_KEY=
TIENDA_DOMINIO_BASE=analitica360.app
ARCHIVOS_URL_PUBLICA=https://api.analitica360.app/archivos
RESEND_API_KEY=
AVISOS_EMAIL=
# Remitente verificado en Resend (ej. Analítica 360 <avisos@analitica360.app>)
AVISOS_EMAIL_DESDE=
# Sesiones de los compradores de las tiendas (32 caracteres o más, al azar)
TIENDA_SESIONES_SECRETO=
# Opcional: "Continuar con Google" en las tiendas (Client ID de Google Cloud)
GOOGLE_CLIENT_ID_TIENDAS=

# Web (las NEXT_PUBLIC_* se fijan al compilar la imagen)
NEXT_PUBLIC_API_URL=https://api.analitica360.app
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_WHATSAPP_CONTACT=5492615469432
NEXT_PUBLIC_TIENDA_LOCAL_URL=
CLERK_WEBHOOK_SECRET=

# Copias de seguridad: hora (UTC; 06 = 3 de la mañana en Argentina) y días que se guardan
BACKUP_HORA=06
BACKUP_DIAS=14

# Mercado Pago (débito automático de los planes): mercadopago.com.ar/developers → Tus integraciones.
# Webhook a configurar en la aplicación: https://api.DOMINIO/webhooks/mercadopago (eventos de suscripciones).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Mercado Pago en las tiendas (OAuth): Client ID y Client Secret de la MISMA aplicación (Tus integraciones → Credenciales de producción).
# En la aplicación, URL de redirección: https://api.<DOMINIO>/mercadopago/tienda/vuelta
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# Factura electrónica ARCA (Factura C). Vacío = apagada.
# CUIT de Analítica 360 (los clientes le delegan wsfe). Certificado y clave en base64, en una línea:
#   base64 -w0 analitica360.crt  /  base64 -w0 analitica360.key  (la .key la arma apps/api/scripts/arca-pedido-certificado.mjs)
ARCA_CUIT=
ARCA_CERTIFICADO=
ARCA_CLAVE=
ARCA_AMBIENTE=homologacion

# Envíos (Zipnova): cifra en la base las credenciales que conecta cada comercio. 32 bytes en base64:
#   openssl rand -base64 32
# ¡No cambiarla después de que haya comercios conectados! (no se podrían leer sus credenciales).
CLAVE_CIFRADO=
