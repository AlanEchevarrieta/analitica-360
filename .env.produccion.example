# Copiar a .env.produccion (ignorado por git) y completar. Lo usa docker-compose.prod.yml.
# En CI/CD estas mismas claves van como "Secrets" / "Variables" del repositorio en GitHub.

# Dominio: en el DNS, apuntar @, www, api y * (comodín, para las tiendas) a la IP del servidor.
DOMINIO=analitica360.app
# Email para los avisos de los certificados HTTPS (Let's Encrypt)
ACME_EMAIL=

# Base de datos (elegir una contraseña larga y aleatoria; nunca la de desarrollo)
POSTGRES_DB=analitica360
POSTGRES_USER=analitica360
POSTGRES_PASSWORD=

# API
CORS_ORIGINS=https://analitica360.app,https://www.analitica360.app
CLERK_SECRET_KEY=
INTERNAL_WEBHOOK_SECRET=
TIENDA_PROXY_KEY=
TIENDA_DOMINIO_BASE=analitica360.app
ARCHIVOS_URL_PUBLICA=https://api.analitica360.app/archivos
RESEND_API_KEY=
AVISOS_EMAIL=
# Remitente verificado en Resend (ej. Analítica 360 <avisos@analitica360.app>)
AVISOS_EMAIL_DESDE=
# Sesiones de los compradores de las tiendas (32 caracteres o más, al azar)
TIENDA_SESIONES_SECRETO=
# Opcional: "Continuar con Google" en las tiendas (Client ID de Google Cloud)
GOOGLE_CLIENT_ID_TIENDAS=

# Web (las NEXT_PUBLIC_* se fijan al compilar la imagen)
NEXT_PUBLIC_API_URL=https://api.analitica360.app
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_WHATSAPP_CONTACT=5492615469432
NEXT_PUBLIC_TIENDA_LOCAL_URL=
CLERK_WEBHOOK_SECRET=

# Copias de seguridad: hora (UTC; 06 = 3 de la mañana en Argentina) y días que se guardan
BACKUP_HORA=06
BACKUP_DIAS=14
