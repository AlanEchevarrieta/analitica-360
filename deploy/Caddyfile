# Proxy con HTTPS automático (Let's Encrypt) para Analítica 360. Lo usa docker-compose.prod.yml.
#   DOMINIO        ej. analitica360.app (apuntar en el DNS: @, www y api al servidor)
#   ACME_EMAIL     email para avisos de los certificados
#
#   https://DOMINIO, https://www.DOMINIO   → la app (web)
#   https://api.DOMINIO                    → la API

{
	email {$ACME_EMAIL}
}

(comun) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

{$DOMINIO}, www.{$DOMINIO} {
	import comun

	# Webhooks públicos (Clerk, etc.) los procesa Next.js con svix
	@webhook path /api/webhooks/*
	handle @webhook {
		reverse_proxy web:4001
	}

	# Si la web llama al backend bajo /api/*, se quita el prefijo y va directo a la API
	@api path /api/*
	handle @api {
		uri strip_prefix /api
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:4001
	}
}

api.{$DOMINIO} {
	import comun
	reverse_proxy api:3001
}
